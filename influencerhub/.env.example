# Frontend (Vite) — publishable/anon key only; never commit service role keys.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Use either name (dashboard may show "publishable" key):
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# VITE_SUPABASE_ANON_KEY=your-anon-key

# Public site URL (no trailing slash) — canonical URLs & JSON-LD
# VITE_SITE_URL=https://your-app.vercel.app

# Optional: apply migrations via scripts/apply-migrations.sh (never commit)
# SUPABASE_DB_PASSWORD=your-database-password

# Local Supabase overrides (see .env.local after `npx supabase start`)
# VITE_SUPABASE_URL=http://127.0.0.1:54321
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Seed scripts only (`npm run db:seed`, `npm run db:seed-admin`) — never commit real values
# SUPABASE_SERVICE_ROLE_KEY=from `npx supabase status -o env`

# Edge functions (Supabase Dashboard → Secrets) — never in Vite env
# CHAPA_SECRET_KEY=CHAPA-SECK-xxxxxxxx
