# Frontend (Vite) — publishable/anon key only; never commit service role keys.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Use either name (dashboard may show "publishable" key):
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# VITE_SUPABASE_ANON_KEY=your-anon-key

# Public site URL (no trailing slash) — canonical URLs & JSON-LD
# VITE_SITE_URL=https://your-app.vercel.app

# Edge functions (Supabase Dashboard → Secrets) — never in Vite env
# CHAPA_SECRET_KEY=CHAPA-SECK-xxxxxxxx
