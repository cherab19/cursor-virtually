# From https://cursor.com/dashboard/integrations
CURSOR_API_KEY=cursor_your_key_here

# Optional: where InfluencerHub app is built (default: ../influencerhub)
# INFLUENCERHUB_CWD=/absolute/path/to/influencerhub

# Cloud build only (npm run build:influencerhub:cloud)
# REPO_URL=https://github.com/ethiopian-cursor-community/your-team-repo
# REPO_REF=main
# AUTO_PR=0
